# =============================================================================
# DIASPORA LINK ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env locally or set these variables in your deployment dashboard (EAS / Vercel / Netlify / GitHub Secrets)
# =============================================================================

# 1. Supabase Realtime Database & Authentication API
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Trade Corridor Default Parameters
EXPO_PUBLIC_DEFAULT_CORRIDOR=KGL_YYZ
EXPO_PUBLIC_BASE_CURRENCY=CAD
EXPO_PUBLIC_FX_RWF_PER_CAD=1333.33

# 3. Payment Settlement Gateways
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
EXPO_PUBLIC_MTN_MOMO_API_KEY=your_momo_api_key

# 4. API & QR Services Gateway
EXPO_PUBLIC_API_URL=https://api.diasporalink.com/v1
EXPO_PUBLIC_QR_SERVICE_URL=https://api.qrserver.com/v1/create-qr-code
